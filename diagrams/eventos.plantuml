@startuml eventos
!include estilo.iuml
title Astro — evento, conclusão e conformidade
start
:Gestor cria evento com NR opcional,\nmodo de conclusão e regra de evidência;
:Criar ao menos uma turma\ne atribuir participantes;
:Participante consulta seu evento;
if (Modo de conclusão?) then (COLABORADOR)
  repeat
    :Participante envia conclusão\ne até três evidências;
    :API verifica participação, turma em andamento\ne evidência obrigatória quando configurada;
    if (Envio válido?) then (sim)
      :Gravar conclusão PENDENTE;\nUI apresenta EM_ANALISE;
      :Gestor criador consulta e valida;
      if (Aprovou?) then (sim)
        :Conclusão = CONCLUIDO;
      else (não)
        :Conclusão = REJEITADO\ncom justificativa;
      endif
    else (não)
      :Exibir erro sem registrar conclusão;
    endif
  repeat while (Envio corrigível / REJEITADO\ne deseja reenviar?) is (sim) not (não)
else (GESTOR)
  :Gestor criador registra conclusão\ndo participante pela API;
  :Validar permissão e condições do evento;
  :Conclusão = CONCLUIDO;
endif
if (Existe conclusão CONCLUIDO?) then (sim)
  if (Evento possui NR?) then (sim)
    :Trigger no PostgreSQL cria / atualiza\nconformidade vinculada à conclusão;
    :Validade = data de conclusão\n+ meses de reciclagem da NR;
    note right
      Regra do código SQL consultado.
      Só ocorre se os scripts estiverem instalados.
      Memorial de setembro usa outra formulação;
      divergência registrada na revisão.
    end note
  else (não)
    :Preservar histórico do evento\nsem gerar conformidade de NR;
  endif
else (não)
  :Manter pendência / rejeição\npara acompanhamento;
endif
:Atualizar listagem e situação do participante;
stop
legend bottom
  Participação na UI: PENDENTE → EM_ANALISE → CONCLUIDO ou REJEITADO.
  Conclusão persistida: PENDENTE → CONCLUIDO ou REJEITADO.
  O criador não participa do próprio evento. Outros gestores não validam por cargo.
endlegend
@enduml
