@startuml casos_de_uso
!include estilo.iuml
title Astro — casos de uso
left to right direction
skinparam nodesep 20
skinparam ranksep 45
skinparam usecaseBackgroundColor #F5F0FC
skinparam usecaseBorderColor #7952A5
skinparam actorBorderColor #645679

actor "Visitante" as visitante
actor "Colaborador" as colaborador
actor "Gestor" as gestor
actor "Gestor do\nWorkspace" as responsavel
actor "Administrador\nAstro" as admin
colaborador <|-- gestor
gestor <|-- responsavel

rectangle "Astro" {
  package "Acesso e uso pessoal" {
    usecase "Criar workspace" as criar
    usecase "Acessar / ativar conta" as acesso
    usecase "Consultar perfil,\nNRs e validades" as perfil
    usecase "Consultar eventos\ne enviar conclusão" as participar
    usecase "Consultar alertas" as alertas
    usecase "Usar chat e Astrinho" as conversar
  }
  package "Gestão" {
    usecase "Gerenciar colaboradores" as pessoas
    usecase "Gerenciar cargos\ne NRs das unidades" as estrutura
    usecase "Gerenciar conformidades" as conformidades
    usecase "Gerenciar eventos\ne validar conclusões" as eventos
    usecase "Criar, analisar e\nresponder formulários" as formularios
    usecase "Consultar indicadores" as indicadores
  }
  package "Responsabilidade do workspace" {
    usecase "Administrar empresa\ne unidades" as empresa
    usecase "Importar colaboradores\npor planilha" as importar
    usecase "Administrar gestores e\ntransferir responsabilidade" as gestores
  }
  package "Administração Astro" {
    usecase "Revisar catálogo de NRs" as catalogo
  }
}
visitante -- criar
visitante -- acesso
colaborador -- perfil
colaborador -- participar
colaborador -- alertas
colaborador -- conversar
gestor -- pessoas
gestor -- estrutura
gestor -- conformidades
gestor -- eventos
gestor -- formularios
gestor -- indicadores
responsavel -- empresa
responsavel -- importar
responsavel -- gestores
admin -- catalogo

legend bottom
  O gestor mantém as funções pessoais do colaborador na mesma conta.
  Colaborador conversa com gestores; gestores também conversam entre si.
  Só o criador do evento valida conclusões; só o destinatário responde ao formulário.
endlegend
@enduml
