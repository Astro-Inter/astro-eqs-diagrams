@startuml casos_de_uso
!include estilo.iuml
title Astro — papéis e casos de uso
left to right direction
skinparam nodesep 20
skinparam ranksep 55
skinparam usecaseBackgroundColor #F5F0FC
skinparam usecaseBorderColor #7952A5
skinparam actorBorderColor #645679

actor "Visitante" as visitante
actor "Colaborador" as colaborador
actor "Gestor" as gestor
actor "Gestor do\nWorkspace" as responsavel
actor "Administrador\nAstro" as admin
colaborador <|-- gestor
gestor <|-- responsavel

rectangle "Astro" {
  package "Acesso e uso pessoal" {
    usecase "Criar workspace\nno web" as criar_workspace
    usecase "Ativar conta pré-cadastrada\nno mobile" as ativar
    usecase "Entrar / recuperar senha" as acesso
    usecase "Consultar perfil, NRs\ne validades próprias" as perfil
    usecase "Consultar eventos atribuídos\ne enviar conclusão / evidências" as participar
    usecase "Consultar alertas" as alertas
    usecase "Conversar com gestores" as chat
    usecase "Conversar com o Astrinho\ne retomar sessões próprias" as ia
  }
  package "Gestão operacional" {
    usecase "Consultar e pré-cadastrar\ncolaboradores" as pessoas
    usecase "Gerenciar cargos e\nsuas NRs" as cargos
    usecase "Consultar unidades e\nassociar NRs contextuais" as unidades
    usecase "Registrar / importar\nconformidades e validades" as conformidades
    usecase "Criar e acompanhar eventos,\nturmas e participantes" as eventos
    usecase "Atribuir ou validar conclusão\ndos eventos que criou" as validar
    usecase "Criar e analisar formulários" as formularios
    usecase "Responder formulários\nrecebidos como destinatário" as responder
    usecase "Consultar dashboards\ndo workspace" as bi
    usecase "Conversar com colaboradores\ne outros gestores" as chat_gestao
  }
  package "Responsabilidade do workspace" {
    usecase "Editar empresa e\ncriar / editar unidades" as empresa
    usecase "Sincronizar colaboradores\npor planilha do workspace" as importar
    usecase "Promover / administrar gestores" as gestores
    usecase "Transferir responsabilidade\na outro gestor ativo" as transferir
  }
  package "Catálogo global" {
    usecase "Revisar e aprovar NRs\npendentes / editar catálogo" as catalogo
  }
}
visitante -- criar_workspace
visitante -- ativar
visitante -- acesso
colaborador -- perfil
colaborador -- participar
colaborador -- alertas
colaborador -- chat
colaborador -- ia
gestor -- pessoas
gestor -- cargos
gestor -- unidades
gestor -- conformidades
gestor -- eventos
gestor -- validar
gestor -- formularios
gestor -- responder
gestor -- bi
gestor -- chat_gestao
responsavel -- empresa
responsavel -- importar
responsavel -- gestores
responsavel -- transferir
admin -- catalogo
admin -- acesso

legend bottom
  Generalização = capacidades pessoais compartilhadas, sem conta adicional.
  Os canais e as permissões do servidor continuam distintos.
  Colaborador: mobile. Gestores: web + mobile. ADMIN: catálogo administrativo.
  Certificados podem ser evidências; não há módulo autônomo confirmado.
  Visão de capacidades do código, não comprovação de deploy ou QA completo.
endlegend
@enduml
