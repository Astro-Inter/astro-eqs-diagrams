@startuml casos_de_uso
!include estilo.iuml
title Astro — casos de uso
left to right direction
skinparam nodesep 20
skinparam ranksep 45
skinparam usecaseBackgroundColor #F5F0FC
skinparam usecaseBorderColor #7952A5
skinparam actorBorderColor #645679

actor "Colaborador" as colaborador
actor "Gestor" as gestor
actor "Responsável pelo\nworkspace" as responsavel
actor "Administrador\nAstro" as admin
colaborador -left-|> gestor
gestor -left-|> responsavel

rectangle "Astro" {
  usecase "Criar workspace" as criar
  usecase "Validar chave\ndo workspace" as validar_chave
  usecase "Acessar conta" as acesso
  usecase "Ativar conta\n(primeiro acesso)" as ativar
  usecase "Consultar perfil,\nNRs e alertas" as perfil
  usecase "Participar de eventos" as participar
  usecase "Usar chat e Astrinho" as conversar
  usecase "Gerenciar equipe\ne conformidades" as equipe
  usecase "Gerenciar eventos\ne formulários" as operacao
  usecase "Consultar indicadores" as indicadores
  usecase "Administrar workspace" as workspace
  usecase "Gerenciar catálogo de NRs" as catalogo
  usecase "Revisar e aprovar NRs\ngeradas por IA" as aprovar_nrs
}
responsavel -- criar
colaborador -- acesso
colaborador -- ativar
colaborador -- perfil
colaborador -- participar
colaborador -- conversar
gestor -- equipe
gestor -- operacao
gestor -- indicadores
responsavel -- workspace
admin -- catalogo
admin -- aprovar_nrs

' Espaços inseparáveis compensam o deslocamento dos rótulos no Smetana.
criar .> validar_chave : <back:white>       «include» </back>
ativar .> acesso : <back:white>       «extend» </back>
@enduml
