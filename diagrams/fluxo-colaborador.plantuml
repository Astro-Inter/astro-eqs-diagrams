@startuml fluxo_colaborador
title Fluxo do colaborador
' Jira: SCRUM-558. Fluxo revisado a partir do ZIP, sem certificados.
!include estilo.iuml
left to right direction
skinparam packageBorderColor #D9CCE8
skinparam nodesep 35
skinparam ranksep 55

partition "Acesso" {
  (*) --> "Informar e-mail" as email
  -right-> if "\n\n<back:white>Primeiro acesso?   </back>" then
    -->[<back:white>Sim</back>] "Validar chave e definir senha" as ativar
    --> "Entrar na conta" as login
  else
    -->[<back:white>Não</back>] login
  endif
  login --> if "\n\n<back:white>Acesso válido?   </back>" then
    -->[<back:white>Sim</back>] "Home" as home
  else
    -->[<back:white>Não</back>] "Exibir erro de acesso" as erro
    --> (*1)
  endif
}

partition "Eventos" {
  home --> "Consultar eventos no calendário" as eventos
  --> if "\n\n<back:white>Abrir detalhes?   </back>" then
    -->[<back:white>Sim</back>] "Consultar detalhes e\nsituação da participação" as detalhes
    --> (*2)
  else
    -->[<back:white>Não</back>] (*3)
  endif
}

partition "NRs" {
  home --> "Consultar NRs, conformidades\ne validades" as nrs
  --> (*4)
}

partition "Astrinho" {
  home --> "Enviar pergunta ao Astrinho" as pergunta
  --> "Receber resposta" as resposta
  --> (*5)
}

partition "Chat com o gestor" {
  home --> "Selecionar gestor e consultar\nhistórico da conversa" as contato
  --> if "\n\n<back:white>Enviar mensagem?   </back>" then
    -->[<back:white>Sim</back>] "Enviar mensagem ao gestor" as mensagem
    --> (*6)
  else
    -->[<back:white>Não</back>] (*7)
  endif
}
@enduml
