@startuml comunicacao
!include estilo.iuml
title Astro — chat humano e Astrinho
start
:Usuário autenticado abre Conversas;
if (Tipo de conversa?) then (Humana)
  :API principal lista conversas / contatos\nno mesmo workspace;
  if (Conversa já existe?) then (sim)
    :Abrir histórico e marcar leitura\npela API principal;
  else (não)
    :Selecionar contato elegível;\nconversa será criada com a primeira mensagem;
  endif
  note right
    Colaborador conversa com gestores.
    Gestor conversa com colaboradores
    e outros gestores elegíveis.
    Não existe chat Colaborador ↔ Colaborador.
  end note
  :Autenticar CONNECT STOMP em /ws\ncom Firebase ID token;
  repeat
    :Enviar mensagem com clientMessageId\na /app/chat.send;
    :Servidor revalida pessoas, perfis\ne workspace;
    if (Envio autorizado?) then (sim)
      :Persistir conversa + mensagem no MongoDB\nantes de confirmar o envio;
      :Atualizar não lidas no Redis\ne publicar entrega privada;
      :Exibir mensagem / confirmação;
    else (não)
      :Exibir erro; preservar operação\npara repetição idempotente quando cabível;
    endif
  repeat while (Enviar outra mensagem?) is (sim) not (não)
else (Astrinho)
  :API de IA lista sessões próprias\nGET /sessions;
  :Escolher nova conversa\nou carregar histórico da sessão;
  repeat
    :POST /chat/messages com token Firebase\ne session_id quando existente;
    :Validar acesso; executar guardrails,\nroteamento e agentes autorizados;
    :Persistir interação em sessoes / MongoDB\ne devolver resposta com UUID da sessão;
    :Apresentar resposta e blocos suportados;
  repeat while (Continuar conversando?) is (sim) not (não)
  note right
    Sair da tela não encerra a sessão
    nem dispara o salvamento do histórico.
    Resumos após inatividade: serviço separado,
    documentado como ENABLED=false.
    Sessões legadas encerradas podem ser
    retomadas por /sessions/{id}/iniciar.
  end note
endif
:Voltar à lista / Home;\no histórico confirmado permanece salvo;
stop
@enduml
