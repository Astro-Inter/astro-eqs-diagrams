@startuml arquitetura
!include estilo.iuml
title Astro — contexto dos repositórios
top to bottom direction
skinparam componentStyle rectangle
skinparam nodesep 35
skinparam ranksep 45
skinparam componentBackgroundColor #F5F0FC
skinparam componentBorderColor #7952A5

[astro-web\nGestores / catálogo ADMIN] as web
[astro-mobile\nColaborador / Gestores] as mobile
cloud "Firebase Authentication" as auth
package "Serviços de produto" {
  [astro-api\nREST / STOMP / regras operacionais] as api
  [astro-ai-api\nAstrinho / agentes / sessões] as ia
  [astro-dashboard-api\nIndicadores autorizados] as bi
  [astro-password-reset\nRecuperação de senha] as reset
}
package "Dados compartilhados por domínio" {
  database "PostgreSQL\nPessoas / workspace / eventos / conformidades" as pg
  database "MongoDB\nNRs / formulários / chat / sessões" as mongo
  database "Redis\nFilas / chaves / contadores / PubSub" as redis
  database "Qdrant\nBusca vetorial" as vetores
  storage "R2\nArquivos / evidências / PDFs" as r2
  database "Databricks\nIndicadores" as lake
}
web --> auth : login
mobile --> auth : login
web --> api : Bearer
mobile --> api : Bearer / STOMP
web --> ia : Bearer
mobile --> ia : Bearer
web --> bi
web --> reset
mobile --> reset
reset --> auth : códigos
api --> pg
api --> mongo
api --> redis
api --> r2
ia --> pg : autorização / consultas
ia --> mongo : sessões
cloud "OpenRouter\nModelos e embeddings" as modelos
ia --> vetores
ia --> modelos
ia --> r2 : PDFs
bi --> pg : escopo
bi --> lake : leitura

note bottom of redis
  **Processamento e suporte**
  astro-email-worker: filas e chaves por e-mail.
  astro-notification-service: regras de prazo e notificações.
  nr-updater: candidatos e sincronização de NRs aprovadas.
  data-integration-rpa: sincronização do legado / Firebase.
  astro-data-cleanup: manutenção e expurgo configurável.
  postgresql-backup: dumps PostgreSQL no R2.
  astro-session-summary-service: resumos; ENABLED=false.
end note
note bottom of lake
  **Análise e observabilidade**
  astro-medallion-api: fontes para consumidor Databricks.
  astro-tracking-api: telemetria de interface no PostgreSQL.
  astro-ai-observabilidade: leitura agregada do LangSmith.
end note
note bottom of pg
  **Documentação e entrega**
  astro-database: scripts e contratos dos dados.
  astro-knowledge: memorial e regras funcionais.
  .github: guia da organização.
  astro-gitops: manifestos de entrega Java / IA.
  astro-eqs-diagrams: modelos e relatório desta revisão.
end note
legend bottom
  As setas detalham os serviços de produto; os demais repositórios estão nos quadros.
  Tokens são validados no backend; ter login não concede acesso a todo workspace.
  Snapshot dos 21 repositórios em 31/10/2026, sem comprovar deploy ou QA completo.
  Bancos agrupados por domínio; push / Firestore / FCM e integrações secundárias omitidos.
  Qdrant é armazenamento vetorial; OpenRouter é provedor externo de modelos.
endlegend
@enduml
