@startuml fluxo_funcionario
!include estilo.iuml
title Astro — fluxo do funcionário

(*) --> "Informar e-mail" as email
--> if "<back:white>Primeiro acesso?   </back>" then
  -->[<back:white>sim</back>] "Ativar conta com chave e senha" as ativar
  --> "Entrar no Astro" as entrar
else
  -->[<back:white>não</back>] entrar
endif

entrar --> "Escolher o que fazer:\n• Consultar perfil, NRs e alertas\n• Acompanhar eventos\n• Conversar com gestor ou Astrinho" as opcoes
--> if "<back:white>Enviar conclusão de evento?   </back>" then
  -->[<back:white>sim</back>] "Enviar conclusão para o gestor" as concluir
  --> "Sair da conta" as sair
else
  -->[<back:white>não</back>] sair
endif
sair --> (*)
@enduml
