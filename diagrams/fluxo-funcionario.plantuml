@startuml fluxo_funcionario
!include estilo.iuml
title Astro — jornada do colaborador no mobile
start
:Informar e-mail e verificar a situação da conta;
if (Primeiro acesso?) then (sim)
  :Validar chave recebida por e-mail;\ndefinir senha e ativar conta;
else (conta ativa)
  :Entrar com e-mail e senha;
endif
:Verificar se a conta pode acessar o sistema;
:Abrir a tela inicial;
repeat
  :Escolher área na navegação;
  switch (Área escolhida)
  case (Eventos)
    :Consultar eventos atribuídos\ne detalhes da participação;
    :Consultar prazo, modo de conclusão\ne exigência de evidência;
    if (Deseja enviar conclusão?) then (sim)
      :Verificar se o evento permite o envio,\no prazo e as evidências exigidas;
      :Enviar conclusão e evidências\npara análise do gestor responsável;
    endif
  case (Perfil e NRs)
    :Abrir perfil e consultar minhas NRs;
    :Visualizar cargo, unidade,\nNRs exigidas e validades;
    note right
      As NRs exigidas da pessoa vêm do cargo.
      As NRs da unidade descrevem o contexto
      da empresa e das inspeções.
    end note
  case (Alertas)
    :Consultar notificações da própria conta;
    :Abrir detalhe e confirmar leitura;
  case (Conversas)
    :Escolher gestor ou Astrinho;
    if (Conversa humana?) then (sim)
      :Escolher um gestor, consultar o histórico\ne enviar mensagem;
      :Salvar a mensagem e avisar o destinatário;
    else (Astrinho)
      :Retomar conversa com o Astrinho\nou iniciar uma nova e enviar a pergunta;
      :Receber a resposta e manter\na conversa salva no histórico;
    endif
  case (Conta)
    :Consultar conta e atualizar\ncampos / foto permitidos;
  endswitch
  :Retornar à navegação;
repeat while (Continuar usando o app?) is (sim) not (não)
:Sair da conta ou deixar o aplicativo;
stop
legend bottom
  Conta desativada ou dados de acesso inválidos impedem a entrada.
  Cada área é uma opção de navegação.
  O histórico das conversas é salvo durante o uso.
endlegend
@enduml
