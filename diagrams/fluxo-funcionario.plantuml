@startuml fluxo_funcionario
!include estilo.iuml
title Astro — jornada do colaborador no mobile

(*) --> "Informar e-mail e verificar\na situação da conta" as identificar
--> if "Primeiro acesso?" then
  -->[sim] "Validar chave recebida por e-mail;\ndefinir senha e ativar conta" as ativar
  --> "Verificar se a conta pode\nacessar o sistema" as verificar_acesso
else
  -->[não] "Entrar com e-mail e senha" as entrar
  --> verificar_acesso
endif
verificar_acesso --> "Abrir a tela inicial e\nescolher área na navegação" as menu

menu -->[Eventos] "Consultar eventos atribuídos\ne detalhes da participação" as eventos
--> "Consultar prazo, modo de conclusão\ne exigência de evidência" as detalhes_evento
--> if "Deseja enviar conclusão?" then
  -->[sim] "Verificar se o evento permite o envio,\no prazo e as evidências exigidas" as verificar_envio
  --> "Enviar conclusão e evidências\npara análise do gestor responsável" as enviar_conclusao
  --> menu
else
  -->[não] menu
endif

menu -->[Perfil e NRs] "Abrir perfil e consultar minhas NRs" as perfil
--> "Visualizar cargo, unidade,\nNRs exigidas e validades" as nrs
note right
  As NRs exigidas da pessoa vêm do cargo.
  As NRs da unidade descrevem o contexto
  da empresa e das inspeções.
end note
nrs --> menu

menu -->[Alertas] "Consultar notificações da própria conta" as alertas
--> "Abrir detalhe e confirmar leitura" as ler_alerta
--> menu

menu -->[Conversas] "Escolher gestor ou Astrinho" as conversas
--> if "Conversa humana?" then
  -->[sim] "Escolher um gestor, consultar o histórico\ne enviar mensagem" as mensagem_humana
  --> "Salvar a mensagem e avisar o destinatário" as salvar_mensagem
  --> menu
else
  -->[não] "Retomar conversa com o Astrinho\nou iniciar uma nova e enviar a pergunta" as pergunta
  --> "Receber a resposta e manter\na conversa salva no histórico" as resposta
  --> menu
endif

menu -->[Conta] "Consultar conta e atualizar\ncampos / foto permitidos" as conta
--> menu

menu -->[Saída] if "Continuar usando o app?" then
  -->[sim] menu
else
  -->[não] "Sair da conta ou deixar o aplicativo" as sair
  --> (*)
endif

legend bottom
  Conta desativada ou dados de acesso inválidos impedem a entrada.
  As setas da tela inicial indicam opções de navegação.
  Losangos representam apenas perguntas com respostas sim ou não.
  O histórico das conversas é salvo durante o uso.
endlegend
@enduml
