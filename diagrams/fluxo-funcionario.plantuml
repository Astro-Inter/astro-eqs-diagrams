@startuml fluxo_funcionario
!include estilo.iuml
title Astro — fluxo do funcionário

(*) --> "Informar e-mail" as identificar
--> if "<back:white>Primeiro acesso?   </back>" then
  -->[<back:white>sim</back>] "Validar chave e criar senha" as ativar
  --> "Abrir tela inicial" as menu
else
  -->[<back:white>não</back>] "Entrar com e-mail e senha" as entrar
  --> menu
endif

menu -->[<back:white>Eventos</back>] "Consultar meus eventos" as eventos
--> if "<back:white>Enviar conclusão?   </back>" then
  -->[<back:white>sim</back>] "Enviar conclusão e evidências\npara análise do gestor" as concluir
  --> menu
else
  -->[<back:white>não</back>] menu
endif

menu -->[<back:white>Perfil</back>] "Consultar dados, NRs e validades" as perfil
--> menu
menu -->[<back:white>Alertas</back>] "Consultar alertas" as alertas
--> menu
menu -->[<back:white>Conversas</back>] "Conversar com gestor ou Astrinho" as conversas
--> menu
menu -->[<back:white>Sair</back>] "Sair da conta" as sair
--> (*)

@enduml
