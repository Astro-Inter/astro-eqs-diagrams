@startuml fluxo_gestor
!include estilo.iuml
title Astro — fluxo do gestor

(*) --> if "<back:white>Criar workspace?   </back>" then
  -->[<back:white>sim</back>] "Validar chave e cadastrar empresa" as criar
  --> "Entrar no Astro" as entrar
else
  -->[<back:white>não</back>] entrar
endif

entrar --> "Escolher o que fazer:\n• Gerenciar equipe e conformidades\n• Gerenciar eventos e formulários\n• Consultar indicadores e conversas" as opcoes
--> if "<back:white>É responsável pelo workspace?   </back>" then
  -->[<back:white>sim</back>] "Administrar empresa e gestores,\nquando necessário" as administrar
  --> "Sair da conta" as sair
else
  -->[<back:white>não</back>] sair
endif
sair --> (*)
@enduml
