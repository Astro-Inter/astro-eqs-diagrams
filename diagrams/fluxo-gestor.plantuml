@startuml fluxo_gestor
!include estilo.iuml
title Fluxo do gestor no web
skinparam ConditionStyle InsideDiamond
skinparam ConditionEndStyle hline
skinparam Padding 10

start
:Abrir Astro;
if (Já tem workspace?) then (Sim)
else (Não)
  :Validar chave de acesso;
  :Cadastrar empresa;
endif
:Acessar workspace;

split
  :Editar dados do workspace;
  stop
split again
  :Configurar NRs da empresa;
  stop
split again
  :Cadastrar e configurar unidade;
  stop
split again
  :Iniciar cadastro manual\nde colaborador;
  if (Unidade cadastrada?) then (Sim)
    :Selecionar unidade;
  else (Não)
    :Cadastrar unidade para\no colaborador;
  endif
  :Definir cargo e suas NRs;
  :Preencher dados do colaborador;
  :Concluir pré-cadastro e\nenviar chave de primeiro acesso;
  stop
split again
  :Preparar planilha\nde colaboradores;
  :Importar dados da planilha;
  :Configurar NRs por cargo;
  :Concluir pré-cadastros e\nenviar chaves de primeiro acesso;
  stop
end split
@enduml
