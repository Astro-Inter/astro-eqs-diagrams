@startuml fluxo_gestor
!include estilo.iuml
title Astro — fluxo do gestor

(*) --> if "Criar workspace?" then
  -->[sim] "Validar chave da empresa" as chave
  --> "Cadastrar empresa, unidades\ne colaboradores por planilha" as criar
  --> "Entrar com e-mail e senha" as entrar
else
  -->[não] entrar
endif
entrar --> "Abrir tela inicial" as menu

menu -->[Colaboradores] "Pré-cadastrar colaboradores\ne enviar chave de primeiro acesso" as pessoas
--> menu
menu -->[Cargos e NRs] "Gerenciar cargos, NRs\ne conformidades" as conformidades
--> menu
menu -->[Eventos] "Gerenciar eventos e\nvalidar conclusões" as eventos
--> menu
menu -->[Formulários] "Criar, analisar ou responder\nformulários recebidos" as formularios
--> menu
menu -->[Consultas] "Consultar indicadores, alertas\ne conversas" as consultas
--> menu

menu -->[Workspace] if "É o responsável?" then
  -->[sim] "Administrar empresa, unidades,\nplanilhas e gestores" as administrar
  --> menu
else
  -->[não] "Manter acesso às funções de gestão" as restringir
  --> menu
endif
menu -->[Sair] "Sair da conta" as sair
--> (*)

legend bottom
  O gestor também tem as funções pessoais do colaborador.
  Cada gestor valida apenas as conclusões dos eventos que criou.
  Cada ação respeita as permissões e o canal web ou aplicativo.
endlegend
@enduml
