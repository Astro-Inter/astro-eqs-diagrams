@startuml fluxo_gestor
!include estilo.iuml
title Astro — fluxo do gestor

(*) --> if "<back:white>Criar workspace?   </back>" then
  -->[<back:white>sim</back>] "Validar chave da empresa" as chave
  --> "Cadastrar empresa, unidades\ne colaboradores por planilha" as criar
  --> "Entrar com e-mail e senha" as entrar
else
  -->[<back:white>não</back>] entrar
endif
entrar --> "Abrir tela inicial" as menu

menu -->[<back:white>Colaboradores</back>] "Pré-cadastrar colaboradores\ne enviar chave de primeiro acesso" as pessoas
--> menu
menu -->[<back:white>Cargos e NRs</back>] "Gerenciar cargos, NRs\ne conformidades" as conformidades
--> menu
menu -->[<back:white>Eventos</back>] "Gerenciar eventos e\nvalidar conclusões" as eventos
--> menu
menu -->[<back:white>Formulários</back>] "Criar, analisar ou responder\nformulários recebidos" as formularios
--> menu
menu -->[<back:white>Consultas</back>] "Consultar indicadores, alertas\ne conversas" as consultas
--> menu

menu -->[<back:white>Workspace</back>] if "<back:white>Responsável?   </back>" then
  -->[<back:white>sim</back>] "Administrar empresa, unidades,\nplanilhas e gestores" as administrar
  --> menu
else
  -->[<back:white>não</back>] "Manter acesso às funções de gestão" as restringir
  --> menu
endif
menu -->[<back:white>Sair</back>] "Sair da conta" as sair
--> (*)

@enduml
